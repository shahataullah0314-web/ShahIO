{
  "name": "shahio",
  "version": "1.5.0",
  "description": "ShahIO: a Windows PlatformIO IDE with workspace tabs, code editing, build/upload, serial monitoring, and integrated terminals",
  "author": "Ataulah Shah",
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "pack": "npm run build:editor && electron-builder --win --dir",
    "dist": "npm run build:editor && electron-builder --win portable",
    "build:editor": "esbuild ui/editor-entry.js --bundle --format=iife --platform=browser --outfile=ui/editor-bundle.js && npm run build:terminal",
    "build:terminal": "esbuild ui/terminal-entry.js --bundle --format=iife --platform=browser --outfile=ui/terminal-bundle.js && node scripts/copy-terminal-css.cjs",
    "test:ui": "node test/ide-dom.cjs && node test/shell-dom.cjs",
    "dist:setup": "python scripts/build-installer.py"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0"
  },
  "build": {
    "appId": "com.shahataullah.shahio",
    "productName": "ShahIO",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*.js",
      "ui/**/*",
      "project-default.json",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE-ShahIO.txt"
      },
      {
        "from": "electron/terminal_worker.py",
        "to": "terminal_worker.py"
      },
      {
        "from": "electron/serial_worker.py",
        "to": "serial_worker.py"
      },
      {
        "from": "vendor/python",
        "to": "python"
      },
      {
        "from": "vendor/git",
        "to": "git"
      },
      {
        "from": "vendor/runtime-manifest.json",
        "to": "runtime-manifest.json"
      },
      {
        "from": "vendor/git-manifest.json",
        "to": "git-manifest.json"
      },
      {
        "from": "resources/starter-project",
        "to": "starter-project"
      },
      {
        "from": "resources/licenses",
        "to": "licenses"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "ShahIO-${version}-portable.exe",
      "requestExecutionLevel": "user"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shahataullah0314-web/ShahIO.git"
  },
  "homepage": "https://github.com/shahataullah0314-web/ShahIO#readme",
  "bugs": {
    "url": "https://github.com/shahataullah0314-web/ShahIO/issues"
  }
}
